[Unit]
Description=vid2idea Discord collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace these two paths if your checkout lives elsewhere.
WorkingDirectory=%h/code/vid2idea/collector
ExecStart=%h/code/vid2idea/collector/.venv/bin/vid2idea run
Environment=PATH=%h/code/vid2idea/.collector-tools/bin:%h/code/vid2idea/collector/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=30
TimeoutStopSec=1200
UMask=0077

[Install]
WantedBy=default.target
