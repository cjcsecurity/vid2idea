# Keep tokens local. Copy to .env and chmod 600 .env.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Optional author filter; empty means all non-bot posts in the channel.
DISCORD_AUTHOR_ID=

PUBLISHING_BACKEND=notion
NOTION_API_TOKEN=
# Optional database ID; the data source ID below is required.
NOTION_LIBRARY_DATABASE_ID=
NOTION_LIBRARY_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
# An existing page in the Projects data source, used for the initial relation.
NOTION_VID2IDEA_PROJECT_PAGE_ID=

# ChatGPT-authenticated Codex CLI. Usage limits apply.
AI_PROVIDER=codex
CODEX_COMMAND=codex
# Empty uses the CLI default; pin a supported model if desired.
CODEX_MODEL=

# Optional: set AI_PROVIDER=openai for API briefs without automatic research.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=

WHISPER_MODEL=small
# Optional read-only personalization. These summaries go to the AI provider.
PROJECT_ROOTS=
GITHUB_OWNER=
BRIEF_CONTEXT=
DATA_DIR=.collector-data
